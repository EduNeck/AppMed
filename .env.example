# =====================================================
# AppMed Backend – Variables de entorno requeridas
# Copiar este archivo como .env y completar los valores
# NUNCA subir el archivo .env al repositorio
# =====================================================

# ---- Aplicación ----
APP_PORT=3000

# ---- Base de datos (MSSQL) ----
DB_HOST=localhost
DB_NAME=appmed
DB_USER=sa
DB_PASS=YourStrongPassword!
# Encriptar la conexión con SSL/TLS (true/false)
DB_ENCRYPT=false
# Confiar en el certificado del servidor (útil en dev con cert auto-firmado)
# En producción debe ser false y usar un certificado válido
DB_TRUST_SERVER_CERT=false

# ---- JWT ----
# Clave secreta para firmar tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_en_produccion
JWT_EXPIRES_IN=8h

# ---- CORS ----
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
